{
    "name": "wieslawgolec/plugin-social",
    "description": "Modernized Mautic Social Bundle for Mautic 7.2+ — X API v2, Facebook Graph v26, Instagram Business Graph, Yelp Places (Foursquare removed)",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": ["mautic", "plugin", "integration", "twitter", "x", "facebook", "instagram", "yelp"],
    "extra": {
        "install-directory-name": "MauticSocialBundle"
    },
    "require": {
        "php": ">=8.2",
        "mautic/core-lib": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticSocialBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticSocialBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
