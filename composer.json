{
    "name": "wieslawgolec/plugin-social",
    "description": "Modernized Mautic Social Bundle for Mautic 7.2+ with X, Facebook, Instagram, Yelp, Mastodon, Bluesky, Google Places, Reddit, Telegram, YouTube, Pinterest, Discord",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": ["mautic", "plugin", "social", "twitter", "mastodon", "bluesky", "discord"],
    "extra": {
        "install-directory-name": "MauticSocialBundle"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "mautic/core-lib": "Required when installed inside Mautic 7.2+ (^7.0)"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticSocialBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticSocialBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
